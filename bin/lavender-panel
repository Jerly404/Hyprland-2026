css.load_from_data(css_content)
Gtk.StyleContext.add_provider_for_screen(Gdk.Screen.get_default(), css, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)

window = Panel()
def sigterm_handler():
    window.alive = False
    window.destroy()
    Gtk.main_quit()
    return False

if GLibUnix:
    GLibUnix.signal_add(GLib.PRIORITY_DEFAULT, signal.SIGTERM, sigterm_handler)
else:
    GLib.unix_signal_add(GLib.PRIORITY_DEFAULT, signal.SIGTERM, sigterm_handler)

Gtk.main()
