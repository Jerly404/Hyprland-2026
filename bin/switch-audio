#!/usr/bin/env bash
# Switch audio between Gigabyte Monitor (GS27QA) and Laptop Speakers (Audio Pro).

MONITOR_PRO_SINK="effect_input.monitor_studio"
MONITOR_SINK="alsa_output.pci-0000_00_1f.3.hdmi-stereo"
LAPTOP_RAW_SINK="alsa_output.usb-ASUSTeK_COMPUTER_INC._C-Media_R__Audio-00.analog-stereo"
LAPTOP_PRO_SINK="effect_input.laptop_speakers_pro"

move_streams() {
    local target="$1"
    python3 -c "
import json, subprocess, sys
target = sys.argv[1]
try:
    res = subprocess.run(['pactl', '-f', 'json', 'list', 'sink-inputs'], capture_output=True, text=True, check=True)
    for stream in json.loads(res.stdout):
        props = stream.get('properties', {})
        app = (props.get('application.name') or props.get('node.name') or '').lower()
        if any(w in app for w in ('effect_output', 'cava')):
            continue
        subprocess.run(['pactl', 'move-sink-input', str(stream['index']), target], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
except Exception:
    pass
" "$target" 2>/dev/null || true
}

notify_percentage() {
    local volume
    volume=$(pactl get-sink-volume "$1" | grep -o '[0-9]\+%' | head -1)
    notify-send -a Volume -r 8 -t 1200 -h string:x-dunst-stack-tag:volume -h boolean:transient:true "$2 · $volume"
}

to_monitor() {
    local target="$MONITOR_SINK"
    if pactl list short sinks | grep -q "$MONITOR_PRO_SINK"; then
        target="$MONITOR_PRO_SINK"
    fi
    pactl set-sink-mute "$MONITOR_SINK" 0
    pactl set-default-sink "$target"
    move_streams "$target"
    if [[ "$target" == "$MONITOR_PRO_SINK" ]]; then
        pactl set-sink-volume "$MONITOR_SINK" 100%
    fi
    notify_percentage "$target" "Monitor"
}

to_laptop() {
    # Asegurar que el hardware base de la laptop no atenúe el sonido
    pactl set-sink-mute "$LAPTOP_RAW_SINK" 0 2>/dev/null || true
    pactl set-sink-volume "$LAPTOP_RAW_SINK" 100% 2>/dev/null || true

    local target="$LAPTOP_RAW_SINK"
    if pactl list short sinks | grep -q "$LAPTOP_PRO_SINK"; then
        target="$LAPTOP_PRO_SINK"
        pactl set-sink-mute "$LAPTOP_PRO_SINK" 0 2>/dev/null || true

    fi

    pactl set-default-sink "$target" 2>/dev/null || true
    move_streams "$target"
    notify_percentage "$target" "Laptop"
}

TARGET="${1:-toggle}"

case "$TARGET" in
    monitor|mon)
        to_monitor
        ;;
    laptop|lap)
        to_laptop
        ;;
    toggle)
        CURRENT=$(pactl get-default-sink 2>/dev/null || true)
        if [[ "$CURRENT" == "$MONITOR_SINK" || "$CURRENT" == "$MONITOR_PRO_SINK" ]]; then
            to_laptop
        else
            to_monitor
        fi
        ;;
    *)
        echo "Uso: $0 [monitor|laptop|toggle]"
        exit 1
        ;;
esac
